# Obligatorias
# En Vercel la pone la integración Neon ↔ Vercel (rol dueño; en Preview, la
# de su branch). La app solo toma de ella host y base: entra como
# app_runtime con APP_DB_PASSWORD (lib/db.js). En local se usa tal cual.
DATABASE_URL=
# Contraseña del rol app_runtime (migración 010). Production y Preview
APP_DB_PASSWORD=
SESSION_SECRET=
PIN_PEPPER=

# Solo en tu .env local, nunca en Vercel: rol dueño (neondb_owner) para
# migraciones y scripts/restaurar-respaldo.js
DATABASE_URL_MIGRATIONS=

# Notificaciones push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protege /api/cron/limpieza (el respaldo nocturno no corre sin ella)
CRON_SECRET=

# Respaldo diario en Google Drive (solo Production; docs/Deployment.md §8)
RESPALDO_DRIVE_URL=
RESPALDO_DRIVE_CLAVE=
